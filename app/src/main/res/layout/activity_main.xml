<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- OpenStreetMap View (Map Mode) -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Telemetry & Controls Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/surface"
        app:strokeColor="@color/surface_border"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BuildFiler"
                    android:textColor="@color/accent"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧭 Heading: --°"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvGpsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 GPS: Waiting for fix…"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Mode Toggle Pill Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeToggle"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡 Profiler"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                app:strokeColor="@color/accent"
                app:cornerRadius="12dp"
                android:layout_marginEnd="8dp"
                android:minWidth="44dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                app:strokeColor="@color/surface_border"
                app:cornerRadius="12dp"
                android:minWidth="44dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Recenter FAB (Map Mode) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabRecenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:backgroundTint="@color/primary"
        app:tint="@color/text_primary"
        app:srcCompat="@android:drawable/ic_menu_mylocation"
        app:layout_constraintBottom_toTopOf="@id/cardProfile"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Recenter on location" />

    <!-- Map Mode Bottom HUD Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProfile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/surface"
        app:strokeColor="@color/surface_border"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTargetName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Facing scanner active"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvTargetCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/badge_bg"
                    android:textColor="@color/badge_text"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:text="SCANNING"
                    android:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTargetDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Point phone at any building in front of you"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />

            <!-- Small / Compact Description for Map Mode -->
            <TextView
                android:id="@+id/tvTargetDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTargetAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/pbScanning"
                style="?android:attr/progressBarStyleHorizontal"
                android:indeterminate="true"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Profiler Mode Full-Screen HUD View -->
    <ScrollView
        android:id="@+id/profilerModeView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cardTopBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Primary Target Card in Profiler Mode -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfilerTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvProfilerTargetName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Facing scanner active"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="21sp" />

                        <TextView
                            android:id="@+id/tvProfilerTargetCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@color/badge_bg"
                            android:textColor="@color/badge_text"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:text="SCANNING" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvProfilerTargetDistance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Point phone at any building in front of you"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvProfilerTargetAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/surface_border"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BUILDING PROFILE &amp; INFORMATION"
                        android:textColor="@color/accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Detailed Full Description -->
                    <TextView
                        android:id="@+id/tvProfilerFullDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No target acquired. Point the phone towards a structure or establishment."
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="8dp" />

                    <!-- Details Pills / Metadata -->
                    <TextView
                        android:id="@+id/tvProfilerDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="10dp"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/pbProfilerScanning"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:indeterminate="true"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="14dp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Other Detected Buildings in Forward Cone -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfilerCandidates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvCandidatesTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DETECTED IN CONE (0)"
                        android:textColor="@color/accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCandidatesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No other structures within cone field of view."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
